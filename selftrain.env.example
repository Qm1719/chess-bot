# Copy to `submission v5/selftrain.env` (preferred) or `submission v5/.env`.
#
# Loading order (`python main.py selftrain` / `python -m ops.selftrain`):
#   - Set SELFTRAIN_ENV_PATH in your shell to an absolute path to load that file; otherwise
#     `selftrain.env` is used if present, else `.env` in this folder.
#   - File values never override variables already set in the process environment (override=False).

# ── Paths / env file override ───────────────────────────────────────────────
# SELFTRAIN_ENV_PATH=
# LICHESS_BASE=https://lichess.org

# ── Lichess (canonical names) ──────────────────────────────────────────────
# Single OAuth token: https://lichess.org/account/oauth/token
# selftrain + `python main.py lichess` set LICHESS_BOT_TOKEN for lichess-bot from this automatically.
LICHESS_TOKEN=
# Bot’s Lichess username (must match exported games — not secret).
LICHESS_BOT_NAME=

# Legacy fallbacks read by ops/selftrain.py if LICHESS_TOKEN / LICHESS_BOT_NAME are unset:
# LICHESS_BOT_TOKEN=
# LICHESS_API_TOKEN=
# SELFTRAIN_BOT_USER=

# ── Repo layout ──────────────────────────────────────────────────────────────
# SELFTRAIN_LICHESS_BOT_DIR defaults to `<v5>/lichess-bot`
# SELFTRAIN_PGN_DIR           defaults to `<lichess-bot>/game_records`
# SELFTRAIN_ARCHIVE_DIR       defaults to `<SELFTRAIN_PGN_DIR>/selftrain_archive`
# SELFTRAIN_STATE_PATH        defaults to `<v5>/data/selftrain_state.json`
# Ingest / bot-run audit append-only log:
# `<v5>/data/selftrain_ingest.log`

# ── Batch limits ────────────────────────────────────────────────────────────
# Wall-clock cap for each lichess-bot subprocess (seconds).
SELFTRAIN_MAX_SECONDS=21600
# Exit lichess-bot after this many *new* PGN files in one bot session (`game_records`).
SELFTRAIN_MAX_GAMES=15
# Draw/loss games that bump `training_games_completed` toward this cap (persisted daily in state).
SELFTRAIN_TRAINING_GAMES=75

# ── State / cadence ───────────────────────────────────────────────────────────
# Daily reset clears training counters and ingested-id list when the local-calendar date advances (YYYYMMDD).
SELFTRAIN_DAILY_RESET=1

# ── Local Stockfish augmentation (primary ingest path) ────────────────────────
# Requires Python `chess`/python-chess and a Stockfish binary (see engine/stockfish_path).
SELFTRAIN_LOCAL_SF=1
SELFTRAIN_SF_PASS1_DEPTH=12
SELFTRAIN_SF_PASS2_DEPTH=18
SELFTRAIN_SF_MISTAKE_CP=80
SELFTRAIN_SF_BLUNDER_CP=200

# ── Wins / housekeeping ──────────────────────────────────────────────────────
SELFTRAIN_DELETE_WIN_PGNS=1

# ── Lichess analysis polling (fallback path only if enabled in code) ─────────
SELFTRAIN_ANALYSIS_MAX_WAIT=1200
SELFTRAIN_ANALYSIS_POLL=30

# ── Notifications (optional) ──────────────────────────────────────────────────
SELFTRAIN_NOTIFY_ONLY_START_END=1
# SELFTRAIN_NOTIFY_DEBUG=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── lichess-bot subprocess watchdog ───────────────────────────────────────────
SELFTRAIN_BOT_MAX_RESTARTS=8
SELFTRAIN_BOT_RESTART_BACKOFF=20
